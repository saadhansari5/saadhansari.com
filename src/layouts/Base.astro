---
import ThemeInit from '../components/ThemeInit.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/site.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Saad Ansari', description = 'Personal writing by Saad Ansari.' } = Astro.props;
const base = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <ThemeInit />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="journal-shell">
      <header class="site-header">
        <a class="wordmark" href={base}>Saad Ansari</a>
        <div class="header-controls">
          <nav aria-label="Main navigation">
            <a href={`${base}writing/`} aria-current={path.startsWith(`${base}writing/`) ? 'page' : undefined}>Writing</a>
            <a href={`${base}exhibits/`} aria-current={path.startsWith(`${base}exhibits/`) ? 'page' : undefined}>Exhibits</a>
            <a href={`${base}about/`} aria-current={path === `${base}about/` ? 'page' : undefined}>About</a>
          </nav>
          <ThemeToggle />
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer"><span>© {new Date().getFullYear()} Saad Ansari</span></footer>
    </div>
  </body>
</html>
