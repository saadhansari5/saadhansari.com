---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Saad Ansari', description = 'Personal writing by Saad Ansari.' } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <title>{title}</title>
  </head>
  <body>
    <header>
      <nav aria-label="Main navigation">
        <a href={base}>Home</a> · <a href={`${base}writing/`}>Writing</a>
      </nav>
    </header>
    <main><slot /></main>
  </body>
</html>
