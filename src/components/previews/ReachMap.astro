<div class="reach-demo">
  <div class="map-topline"><span>EXHIBIT 001</span><span>ILLUSTRATIVE MAP</span></div>
  <svg class="reach-map" viewBox="0 0 680 310" role="img" aria-labelledby="reach-title reach-description">
    <title id="reach-title">A small atlas of proximity</title>
    <desc id="reach-description">An illustrative landscape with a path, landmarks, and concentric rings. The control below changes the rings' reach. It does not represent a real location or travel times.</desc>
    <defs>
      <pattern id="map-grid" width="34" height="34" patternUnits="userSpaceOnUse"><path d="M34 0H0V34" class="grid-line" fill="none" /></pattern>
    </defs>
    <path d="M0 0h680v310H0z" fill="url(#map-grid)" />
    <g class="contour-lines" fill="none">
      {[0, 1, 2, 3, 4].map(i => <path d={`M${380+i*18} -30C${485+i*16} 59 ${326+i*21} 104 ${420+i*20} 182S${542+i*18} 269 ${497+i*21} 350`} />)}
      {[0, 1, 2].map(i => <path d={`M-30 ${40+i*17}C80 ${-20+i*20} 123 ${96+i*20} 216 ${40+i*17}S295 ${-15+i*15} 352 -20`} />)}
    </g>
    <path class="map-water" d="M540 -10C464 70 557 99 498 179S554 245 510 320h180V-10Z" />
    <path class="map-route" d="M95 273L178 209L257 198L320 154L382 140L426 84L460 58" fill="none" />
    <g class="reach-rings" fill="none">
      <circle cx="320" cy="154" r="45" />
      <circle cx="320" cy="154" r="90" />
      <circle cx="320" cy="154" r="135" />
    </g>
    <g class="map-landmarks">
      <circle cx="178" cy="209" r="4" /><circle cx="426" cy="84" r="4" /><circle cx="257" cy="198" r="4" />
      <circle class="map-origin" cx="320" cy="154" r="6" />
    </g>
    <g class="map-labels">
      <text x="331" y="147">YOU ARE HERE</text><text x="184" y="232">A FAMILIAR PLACE</text>
      <text x="436" y="76">SOMETHING NEW</text><text x="578" y="257" transform="rotate(-90 578 257)">THE WATER'S EDGE</text>
    </g>
  </svg>
  <div class="reach-controls">
    <label for="reach-range">Change your radius</label>
    <input id="reach-range" type="range" min="25" max="65" step="1" value="45" />
    <output for="reach-range" id="reach-output">Neighborhood</output>
  </div>
</div>
<script>
  const slider = document.querySelector<HTMLInputElement>('#reach-range');
  const output = document.querySelector<HTMLOutputElement>('#reach-output');
  const rings = document.querySelectorAll<SVGCircleElement>('.reach-rings circle');
  slider?.addEventListener('input', () => {
    const radius = Number(slider.value);
    rings.forEach((ring, index) => ring.setAttribute('r', String(radius * (index + 1))));
    if (output) output.value = radius < 37 ? 'Close to home' : radius < 53 ? 'Neighborhood' : 'Further afield';
  });
</script>
